p_output = function(formula, title){
  library(pander)
  data = as.data.frame(formula)
  data$Significance = symnum(data$`Pr(>F)`,
                         corr = FALSE, na = FALSE,
                         cutpoints = c(0, 0.001, 0.01, 0.05, 0.1, 1),
                         symbols = c("***", "**", "*", ".", " "))
  pander(data, caption = title)
}
