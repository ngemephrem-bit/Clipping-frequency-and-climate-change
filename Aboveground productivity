## LME for ANPP

set.seed(123)

ANPP_year_df1 = Productivity %>%
  group_by(Shelter,Clipping, Precipitation, Treatment) %>%
  summarise(ANPP = sum(ANPP, na.rm = T), .groups = "drop")

model = lmer(ANPP ~ Precipitation*Clipping + (1|Shelter), data = ANPP_year_df1)

residuals = simulateResiduals(model)
plot(residuals)

anova = Anova(model, test = "F")
print(anova)

emm = emmeans(model, ~ Clipping | Precipitation)
pairwise_comp = as.data.frame(pairs(emm))
pander(pairwise_comp, caption = 'Contrasting treatment effects on 21-months ANPP')

# Treatments comparison
model_trt = lmer(ANPP ~ Treatment + (1 | Shelter), data = ANPP_year_df1)
emm_trt = emmeans(model_trt, ~ Treatment)

cld_trt = cld( emm_trt, alpha = 0.05, Letters = letters, adjust = "sidak")

cld_trt_df = as.data.frame(cld_trt)
cld_trt_df$.group = gsub(" ", "", cld_trt_df$.group)

pander(cld_trt_df, caption = "CLD letters for Treatment effects on 21-month ANPP")

# Pairwise contrasts
pairwise_comp =as.data.frame(pairs(emm_trt, adjust = "sidak"))
pander(pairwise_comp, caption = "Pairwise contrasts among Treatments on 21-month")

