  aov = Anova(model, test = "F")
  grp_season_df[[grp]] = aov
  
  emm = emmeans(model, ~ Clipping | Precipitation | Season)
  pairwise = pairs(emm)
  post_hoc_list[[grp]] = pairwise
  
