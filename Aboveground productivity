# Functional groups responses
grp_season_df = list()
post_hoc_list = list()

for(grp in unique(ANPP_season_df$Group)){
  data = subset(ANPP_season_df, Group == grp)
  model1 = lmer(ANPP ~ Season*Precipitation*Clipping + (1|Shelter),
                     data = data)
